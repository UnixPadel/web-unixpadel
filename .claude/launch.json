{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4322"
      ],
      "port": 4322
    },
    {
      "name": "wp",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "@wp-playground/cli@latest",
        "server",
        "--port=9400",
        "--php=8.2",
        "--mount=./wp-plugin-build/unixpadel-static:/wordpress/wp-content/plugins/unixpadel-static",
        "--mount=./scripts/playground:/wordpress/upx-seed",
        "--blueprint=./scripts/playground/blueprint.json",
        "--login"
      ],
      "port": 9400
    }
  ]
}
