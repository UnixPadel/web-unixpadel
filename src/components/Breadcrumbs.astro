---
export interface Crumb {
  label: string;
  url: string;
}

import { langOf, t } from '../i18n';

const { crumbs } = Astro.props as { crumbs: Crumb[] };
const ui = t(langOf(Astro.url));
---

{
  crumbs.length > 1 && (
    <nav class="breadcrumbs" aria-label={ui.breadcrumb}>
      <ol>
        {crumbs.map((c, i) => (
          <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.url}>{c.label}</a>}</li>
        ))}
      </ol>
    </nav>
  )
}
