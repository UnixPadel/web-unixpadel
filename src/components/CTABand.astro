---
import Icon from './Icon.astro';
import Arc from './graphics/Arc.astro';
import { SITE, quoteUrl, whatsappUrl } from '../data/site';
import { CTA_PHOTO } from '../data/showcase';
import { mediaUrl, srcsetFor } from '../lib/media';
import { langOf, localizePath, t } from '../i18n';

interface Props {
  /** `*word*` renders as a lime highlight */
  title?: string;
  text?: string;
  /** Product URL to pre-select in the quote form. */
  quoteFor?: string | null;
  primaryLabel?: string;
  whatsappText?: string;
  /** background photo (duotone); defaults to a court photo, pass null for a plain band */
  photo?: string | null;
}
const lang = langOf(Astro.url);
const ui = t(lang);
const {
  title = ui.ctaTitle,
  text = ui.ctaText,
  quoteFor = null,
  primaryLabel = ui.getQuote,
  whatsappText = ui.waProject,
  photo = CTA_PHOTO.src,
} = Astro.props;
const parts = title.split(/\*([^*]+)\*/);
---

<section class="cta">
  {
    photo && (
      <div class="cta__photo photo photo--duotone" aria-hidden="true">
        <img src={mediaUrl(photo)} srcset={srcsetFor(photo) ?? undefined} sizes="100vw" alt="" width="1080" height="1080" loading="lazy" decoding="async" />
      </div>
    )
  }
  <Arc class="cta__arc" />
  <div class="container cta__inner" data-reveal>
    <div class="cta__text">
      <h2>{parts.map((p, i) => (i % 2 ? <mark class="hl">{p}</mark> : p))}</h2>
      <p>{text}</p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--primary" href={localizePath(quoteUrl(quoteFor), lang)}>{primaryLabel}</a>
      <a class="btn btn--whatsapp" href={whatsappUrl(whatsappText)} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
      <a class="cta__phone" href={SITE.phoneHref}><Icon name="phone" /> {SITE.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--bg-inverse);
    color: var(--text-on-inverse);
    padding-block: clamp(64px, 10vw, 144px);
  }
  .cta__photo {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .cta__photo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgb(11 19 38 / 92%) 0%, rgb(11 19 38 / 70%) 60%, rgb(11 19 38 / 40%) 100%);
  }
  .cta :global(.cta__arc) {
    position: absolute;
    z-index: 1;
    inset-inline-end: -6%;
    inset-block-end: -20%;
    inline-size: min(60vw, 640px);
    transform: scaleY(-1);
  }
  .cta__inner {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--sp-6);
    align-items: end;
  }
  @media (min-width: 960px) {
    .cta__inner {
      grid-template-columns: 1.5fr 1fr;
    }
    .cta__actions {
      justify-self: end;
    }
  }
  .cta__text {
    display: grid;
    gap: var(--sp-4);
    max-inline-size: 44rem;
  }
  .cta__text h2 {
    color: var(--text-on-inverse);
    font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4.5rem);
    line-height: 1;
  }
  .cta__text p {
    color: var(--text-on-inverse-muted);
    font-size: var(--fs-500);
    max-inline-size: var(--measure);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
  }
  .cta__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-block-size: 48px;
    color: var(--text-on-inverse);
    font-weight: 500;
    text-decoration: none;
  }
  .cta__phone :global(.icon) {
    color: var(--accent-on-inverse);
  }
  @media (hover: hover) {
    .cta__phone:hover {
      color: var(--accent-on-inverse);
    }
  }
</style>
