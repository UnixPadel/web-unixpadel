---
// Collage of a page's images with a native <dialog> lightbox (focus trap, Escape, arrow keys).
// CAD renders / PNGs sit on a white court-line plate; photos fill their tile.
import Icon from './Icon.astro';
import { mediaUrl, srcsetFor } from '../lib/media';
import { langOf, t } from '../i18n';
import { M, T } from '../lib/upx-contract.mjs';

interface Props {
  images: { src: string; alt?: string | null }[];
  title?: string;
  eyebrow?: string;
  /**
   * Reference shell (src/lib/upx-contract.mjs): one item between each:gallery-item markers, count class, item
   * fields and the lightbox JSON as tokens; the WordPress plugin repeats the item per image or drops the section.
   */
  shell?: boolean;
}
const lang = langOf(Astro.url);
const ui = t(lang);
const { images, title = ui.gallery, eyebrow = ui.gallery, shell = false } = Astro.props;
const isRender = (src: string) => /\.png($|#)/i.test(src) || /cad|render|drawing|isometric|layout|diagram/i.test(src);
const items = shell
  ? [{ src: T.G_SRC, alt: T.G_ALT, render: false }]
  : images.map((im, i) => ({
      src: im.src.replace(/#.*$/, ''),
      alt: im.alt || ui.galleryImage(i + 1),
      render: isRender(im.src) || /cad|render|drawing|isometric|layout|diagram|3d/i.test(im.alt ?? ''),
    }));
const uid = shell ? 'shell' : Math.random().toString(36).slice(2, 7);
const mark = (html: string) => (shell ? html : '');
const gridMod = shell ? T.G_N : String(Math.min(items.length, 5));
const itemsJson = shell ? T.G_JSON : JSON.stringify(items.map((it) => ({ src: mediaUrl(it.src), alt: it.alt, render: it.render })));
---

<Fragment set:html={mark(M.open('if:gallery'))} />
{
  items.length > 0 && (
    <section class="gallery section section--tight" data-gallery aria-labelledby={`g-${uid}`}>
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">{eyebrow}</p>
          <h2 id={`g-${uid}`}>{title}</h2>
        </div>
        <ul class:list={['gallery__grid', `gallery__grid--${gridMod}`]} role="list">
          <Fragment set:html={mark(M.open('each:gallery-item'))} />
          {items.map((it, i) => (
            <li class:list={['gallery__item', { 'gallery__item--render': it.render }, shell && T.G_RENDER]} data-reveal>
              <button class="gallery__btn" type="button" data-index={shell ? T.G_INDEX : i} aria-label={ui.enlarge(it.alt)}>
                <img
                  src={mediaUrl(it.src)}
                  srcset={srcsetFor(it.src) ?? undefined}
                  sizes="(min-width: 960px) 33vw, 50vw"
                  alt={it.alt}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                />
                <span class="gallery__zoom" aria-hidden="true">
                  <Icon name="expand" />
                </span>
              </button>
            </li>
          ))}
          <Fragment set:html={mark(M.close('each:gallery-item'))} />
        </ul>
      </div>
      <dialog class="lightbox" aria-label={ui.viewer(title)}>
        <div class="lightbox__frame">
          <img class="lightbox__img" alt="" />
          <p class="lightbox__caption" aria-live="polite" />
        </div>
        <button class="lightbox__btn lightbox__close" type="button" data-close aria-label={ui.closeViewer}>
          <Icon name="close" />
        </button>
        {(shell || items.length > 1) && (
          <>
            <Fragment set:html={mark(M.open('if:gallery-nav'))} />
            <button class="lightbox__btn lightbox__prev" type="button" data-step="-1" aria-label={ui.prevImage}>
              <Icon name="chevron-left" />
            </button>
            <button class="lightbox__btn lightbox__next" type="button" data-step="1" aria-label={ui.nextImage}>
              <Icon name="chevron-right" />
            </button>
            <Fragment set:html={mark(M.close('if:gallery-nav'))} />
          </>
        )}
        <script type="application/json" data-items set:html={itemsJson} />
      </dialog>
    </section>
  )
}
<Fragment set:html={mark(M.close('if:gallery'))} />

<style>
  .gallery__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: dense;
  }
  @media (min-width: 960px) {
    .gallery__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: 220px;
    }
    .gallery__item:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }
    .gallery__grid--2 .gallery__item {
      grid-column: span 2;
      grid-row: span 2;
    }
    .gallery__grid--4 .gallery__item:nth-child(4),
    .gallery__grid--5 .gallery__item:nth-child(5) {
      grid-column: span 2;
    }
  }
  @media (max-width: 959px) {
    .gallery__item {
      aspect-ratio: 1 / 1;
    }
    .gallery__item:first-child {
      grid-column: span 2;
      aspect-ratio: 16 / 10;
    }
  }
  .gallery__btn {
    position: relative;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--navy-900);
    cursor: zoom-in;
  }
  .gallery__btn img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }
  .gallery__item--render .gallery__btn {
    background-color: var(--media-plate);
    background-image:
      linear-gradient(rgb(20 39 78 / 6%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(20 39 78 / 6%) 1px, transparent 1px);
    background-size: 40px 40px;
    border: 1px solid var(--border);
  }
  .gallery__item--render .gallery__btn img {
    object-fit: contain;
    padding: var(--sp-3);
  }
  .gallery__zoom {
    position: absolute;
    inset-inline-end: var(--sp-2);
    inset-block-end: var(--sp-2);
    display: grid;
    place-items: center;
    inline-size: 36px;
    block-size: 36px;
    border-radius: var(--radius-sm);
    background: var(--navy-700);
    color: var(--lime-500);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .gallery__zoom :global(.icon) {
    inline-size: 18px;
    block-size: 18px;
  }
  .gallery__btn:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }
  .gallery__btn:focus-visible .gallery__zoom {
    opacity: 1;
  }
  @media (hover: hover) {
    .gallery__btn:hover img {
      transform: scale(1.03);
    }
    .gallery__btn:hover .gallery__zoom {
      opacity: 1;
    }
  }
  @media (hover: none) {
    .gallery__zoom {
      opacity: 1;
    }
  }

  /* ---- lightbox */
  .lightbox {
    inline-size: 100vw;
    block-size: 100dvh;
    max-inline-size: none;
    max-block-size: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(7 13 28 / 96%);
    color: var(--white);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox::backdrop {
    background: rgb(7 13 28 / 80%);
  }
  .lightbox__frame {
    display: grid;
    gap: var(--sp-3);
    justify-items: center;
    max-inline-size: min(92vw, 1400px);
    padding: var(--sp-8) var(--sp-4) var(--sp-5);
  }
  .lightbox__img {
    max-inline-size: 100%;
    max-block-size: calc(100dvh - 160px);
    inline-size: auto;
    block-size: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }
  .lightbox__img.is-render {
    background: var(--white);
    padding: var(--sp-4);
  }
  .lightbox__caption {
    font-size: var(--fs-300);
    color: var(--text-on-inverse-muted);
    text-align: center;
    max-inline-size: 60ch;
  }
  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    inline-size: 48px;
    block-size: 48px;
    border: 1px solid rgb(255 255 255 / 30%);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 8%);
    color: var(--white);
  }
  .lightbox__btn :global(.icon) {
    inline-size: 22px;
    block-size: 22px;
  }
  .lightbox__close {
    inset-block-start: var(--sp-4);
    inset-inline-end: var(--sp-4);
  }
  .lightbox__prev {
    inset-inline-start: var(--sp-4);
    inset-block-start: 50%;
    transform: translateY(-50%);
  }
  .lightbox__next {
    inset-inline-end: var(--sp-4);
    inset-block-start: 50%;
    transform: translateY(-50%);
  }
  .lightbox__btn:focus-visible {
    outline: 2px solid var(--lime-500);
  }
  @media (hover: hover) {
    .lightbox__btn:hover {
      background: rgb(255 255 255 / 18%);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] .lightbox__img {
      animation: lb-in 220ms var(--ease-out);
    }
    @keyframes lb-in {
      from {
        opacity: 0;
        transform: scale(0.98);
      }
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const caption = dialog.querySelector<HTMLElement>('.lightbox__caption')!;
    const items: { src: string; alt: string; render: boolean }[] = JSON.parse(dialog.querySelector('[data-items]')!.textContent!);
    let index = 0;
    let opener: HTMLElement | null = null;
    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const it = items[index];
      img.src = it.src;
      img.alt = it.alt;
      img.classList.toggle('is-render', it.render);
      caption.textContent = `${it.alt} (${index + 1} / ${items.length})`;
    };
    root.querySelectorAll<HTMLButtonElement>('.gallery__btn').forEach((b) =>
      b.addEventListener('click', () => {
        opener = b;
        show(Number(b.dataset.index));
        dialog.showModal();
      }),
    );
    dialog.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => show(index + Number(b.dataset.step))));
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });
    dialog.addEventListener('close', () => opener?.focus());
  });
</script>
