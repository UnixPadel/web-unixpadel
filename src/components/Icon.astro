---
interface Props {
  name: string;
  /** Accessible label; omit for decorative icons. */
  label?: string;
  class?: string;
  size?: number;
}
const { name, label, class: cls, size } = Astro.props;
const style = size ? `inline-size:${size}px;block-size:${size}px` : undefined;
const filled = name === 'whatsapp' || name === 'play';
// Arrows and side chevrons are mirrored on right-to-left pages (base.css).
const directional = /^(arrow-(right|left|up-right)|chevron-(left|right))$/.test(name);
---

<svg
  class:list={['icon', { 'icon--fill': filled, 'icon--dir': directional }, cls]}
  style={style}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <use href={`#i-${name}`}></use>
</svg>
