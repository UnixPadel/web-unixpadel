---
// "At a glance" strip under the product hero: up to four measured figures from the page's own specs.
import Numeral from './graphics/Numeral.astro';
import { keyFacts, type Spec } from '../lib/specs';
import { langOf, t } from '../i18n';

interface Props {
  specs?: Spec[];
}
const lang = langOf(Astro.url);
const facts = keyFacts(Astro.props.specs, 4, lang);
---

{
  facts.length >= 2 && (
    <section class="facts" aria-label={t(lang).keyFigures}>
      <div class="container">
        <dl class="facts__list" style={`--n:${facts.length}`}>
          {facts.map((f) => (
            <Numeral value={f.value} unit={f.unit} label={f.label} icon={f.icon} size="md" />
          ))}
        </dl>
      </div>
    </section>
  )
}

<style>
  .facts {
    background: var(--bg-page);
    border-block-end: 1px solid var(--border);
  }
  .facts__list {
    margin: 0;
    display: grid;
    gap: var(--sp-5) var(--sp-4);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-block: var(--sp-6);
  }
  @media (min-width: 900px) {
    .facts__list {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      padding-block: var(--sp-7);
    }
  }
</style>
