---
// 404 of each translated language (dist/<lang>/404/index.html), served by the plugin for /<lang>/ misses.
// Same markup as src/pages/404.astro; it is a regular route, so astro.config keeps it out of the sitemap.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CTABand from '../../components/CTABand.astro';
import { PREFIXED, localizePath, t, type Lang } from '../../i18n';

export const getStaticPaths = () => PREFIXED.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const ui = t(lang);
const L = (url: string) => localizePath(url, lang);
---

<BaseLayout url={`/${lang}/404/`} seoTitle={`${ui.e404Title} | Unixpadel`} description={ui.e404Tagline} robots="noindex, follow">
  <Hero eyebrow={ui.e404Eyebrow} title={ui.e404Title} tagline={ui.e404Tagline} size="compact" ctas={[{ label: ui.e404Courts, href: L('/our-courts/'), variant: 'primary' }, { label: ui.e404Refs, href: L('/references/') }, { label: ui.e404Guide, href: L('/padel-guide/') }]} />
  <div class="container section section--tight">
    <div class="prose">
      <p>{ui.e404Lost} <a href={L('/')}>{ui.e404Home}</a> {ui.e404Or} <a href={L('/contact-us/')}>{ui.e404Contact}</a> {ui.e404End}</p>
    </div>
  </div>
  <CTABand />
</BaseLayout>
