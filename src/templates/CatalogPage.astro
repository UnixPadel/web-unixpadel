---
// /catalog/: the product catalogue as a flipbook. Copy comes from catalog.md, pages from src/data/catalog.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Hero from '../components/Hero.astro';
import CTABand from '../components/CTABand.astro';
import CatalogViewer from '../components/CatalogViewer.astro';
import { labelOf } from '../lib/collection';
import type { TemplateProps } from './_types';
import { langOf, t } from '../i18n';

const { page, crumbs, jsonLd } = Astro.props as TemplateProps;
const { data } = page;
const ui = t(langOf(Astro.url));
---

<BaseLayout page={page} url={data.url} seoTitle={data.seo.title ?? labelOf(page)} description={data.seo.description} ogImage={data.seo.ogImage} robots={data.seo.robots} jsonLd={jsonLd}>
  <Hero eyebrow={ui.catalog.eyebrow} title={labelOf(page)} tagline={data.hero?.tagline} size="compact">
    <Breadcrumbs slot="crumbs" crumbs={crumbs} />
  </Hero>
  <CatalogViewer title={labelOf(page)} />
  <CTABand />
</BaseLayout>
