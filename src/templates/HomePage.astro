</style>

<script>
  // Court range: the stage image follows the hovered / focused list item.
  const items = [...document.querySelectorAll<HTMLElement>('[data-range-item]')];
  const figures = [...document.querySelectorAll<HTMLElement>('[data-range-figure]')];
  const activate = (i: string) => {
    items.forEach((el) => el.classList.toggle('is-active', el.dataset.rangeItem === i));
    figures.forEach((el) => el.classList.toggle('is-active', el.dataset.rangeFigure === i));
  };
  items.forEach((el) => {
    el.addEventListener('mouseenter', () => activate(el.dataset.rangeItem!));
    el.addEventListener('focusin', () => activate(el.dataset.rangeItem!));
  });
  activate('0');
</script>
