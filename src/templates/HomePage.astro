    grid-template-areas: 'no title' 'no meta';
    gap: 2px var(--sp-2);
    padding-block: var(--sp-3);
    border-block-end: 1px solid var(--border);
    color: var(--text-primary);
    text-decoration: none;
  }
  .guide-list__no {
    grid-area: no;
    font-family: var(--font-display);
    font-weight: 700;
